# Hemix Bot V1.0 Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
SESSION_SECRET=change-this-to-a-random-secret-string
NODE_ENV=production

# Dashboard URL (IMPORTANT for Katabump/Pterodactyl hosting)
# Set this to your panel's assigned domain or IP so the bot shows the
# correct dashboard link in WhatsApp replies instead of "localhost".
# Example: DASHBOARD_URL=http://mypanel.katabump.com:3000
DASHBOARD_URL=

# Database
DATABASE_URL=data/hemix.json

# AI Configuration
AI_API_KEY=
AI_BASE_URL=https://agentrouter.org/v1
AI_MODEL=auto

# Bot Configuration
OWNER_NUMBER=
BOT_PREFIX=.
BOT_MODE=private
BOT_NAME=Hemix
OWNER_NAME=Owner
TIMEZONE=Asia/Karachi

# Logging
LOG_LEVEL=info
