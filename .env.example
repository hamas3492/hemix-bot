# ═══════════════════════════════════════════════════════════════════
# Hemix Bot V1.0 — Environment Configuration
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# On Katabump: upload this as .env to the root of your server.

# ─── Server ───────────────────────────────────────────────────────
# Katabump sets PORT automatically. Don't change this.
PORT=3000
NODE_ENV=production

# ─── Security ──────────────────────────────────────────────────────
# Generate a random secret: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-random-secret

# ─── Dashboard Public URL (optional) ───────────────────────────────
# A public URL is auto-generated on startup (shown in Console tab).
# Set these only if you have a custom domain.
# DASHBOARD_URL=https://your-domain.com
# CORS_ORIGINS=https://your-domain.com

# ─── Tunnel Configuration (optional) ───────────────────────────────
# Auto-tunnel is enabled by default. Set to false to disable.
# ENABLE_TUNNEL=false
# TUNNEL_SUBDOMAIN=hemix (optional, may not always be available)

# ─── AI Configuration ──────────────────────────────────────────────
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://agentrouter.org/v1
AI_MODEL=auto

# ─── Bot Configuration ──────────────────────────────────────────────
BOT_NAME=Hemix
BOT_PREFIX=.
BOT_MODE=private
OWNER_NUMBER=923001234567
OWNER_NAME=Owner
FOOTER=Powered by Hemix Bot V1.0
MENU_STYLE=1
TIMEZONE=Asia/Karachi
VERSION=1.0.0

# ─── Database ──────────────────────────────────────────────────────
DATABASE_URL=data/hemix.db
