# ═══════════════════════════════════════════════════════════════════
# Hemix Bot V1.0 — Production Environment Configuration
# ═══════════════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Security ──────────────────────────────────────────────────────
# Generate a random secret: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-random-secret

# ─── Production URLs (no localhost/127.0.0.1/0.0.0.0) ──────────────
# Set these to your actual deployment URL(s)
# DASHBOARD_URL=https://your-app.katabump.com
# API_URL=https://your-app.katabump.com
# CORS_ORIGINS=https://your-app.katabump.com

# ─── WhatsApp Session ──────────────────────────────────────────────
# Session files are stored here (auto-created). Persist this directory.
SESSION_PATH=data/session

# ─── AI Configuration ──────────────────────────────────────────────
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://agentrouter.org/v1
AI_MODEL=auto

# ─── Bot Configuration ──────────────────────────────────────────────
BOT_NAME=Hemix
BOT_PREFIX=.
BOT_MODE=private
OWNER_NUMBER=923001234567
OWNER_NAME=Owner
FOOTER=Powered by Hemix Bot V1.0
MENU_STYLE=1
TIMEZONE=Asia/Karachi
VERSION=1.0.0

# ─── Database ──────────────────────────────────────────────────────
DATABASE_URL=data/hemix.db
