# ═══════════════════════════════════════════════════════════════════
# Hemix Bot V1.0 — Environment Configuration
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# Works on ANY platform — Katabump, Heroku, Railway, Render, VPS, Docker.

# ─── Server ───────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Security ──────────────────────────────────────────────────────
# Generate a random secret: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-random-secret

# ─── Dashboard Public URL ──────────────────────────────────────────
# AUTO-DETECTED on Heroku, Railway, Render, Replit, Glitch.
# On Katabump/panels without a public URL, an auto-URL is created automatically.
# Set ENABLE_TUNNEL=false ONLY if you don't want auto public URL.
# ENABLE_TUNNEL=false

# Optional: Set your own domain
# DASHBOARD_URL=https://your-domain.com
# CORS_ORIGINS=https://your-domain.com

# ─── AI Configuration ──────────────────────────────────────────────
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://agentrouter.org/v1
AI_MODEL=auto

# ─── Bot Configuration ──────────────────────────────────────────────
BOT_NAME=Hemix
BOT_PREFIX=.
BOT_MODE=private
OWNER_NUMBER=923001234567
OWNER_NAME=Owner
FOOTER=Powered by Hemix Bot V1.0
MENU_STYLE=1
TIMEZONE=Asia/Karachi
VERSION=1.0.0

# ─── Database ──────────────────────────────────────────────────────
DATABASE_URL=data/hemix.db
