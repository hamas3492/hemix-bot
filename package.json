{
  "name": "hemix-bot",
  "version": "1.0.0",
  "description": "Hemix Bot V1.0 \u2014 A modern self-pairing WhatsApp bot with AI, automation, group management, media tools and a web dashboard.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "build": "tsc && npm run build:css",
    "lint": "eslint src/ --ext .ts",
    "docker:start": "docker-compose up -d",
    "docker:logs": "docker-compose logs -f",
    "docker:stop": "docker-compose down",
    "postinstall": "tsc && npm run build:css",
    "build:css": "tailwindcss -i dashboard/src/tailwind-input.css -o dashboard/public/css/tailwind.css --minify"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "hemix",
    "ai",
    "chatbot",
    "dashboard",
    "baileys"
  ],
  "author": "Hemix",
  "license": "MIT",
  "dependencies": {
    "@distube/ytdl-core": "^4.13.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^9.0.8",
    "@types/yt-search": "^2.10.3",
    "@whiskeysockets/baileys": "^6.7.0",
    "axios": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "chalk": "^4.1.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-session": "^1.18.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lowdb": "^7.0.1",
    "node-cache": "^5.1.2",
    "os-utils": "^0.0.14",
    "pino": "^9.0.0",
    "qrcode": "^1.5.3",
    "sharp": "^0.33.0",
    "systeminformation": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "uuid": "^9.0.1",
    "yt-search": "^2.10.4"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.13.0",
